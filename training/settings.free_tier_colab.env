# Bounded adapter pilot for a free-tier Colab T4 (16 GB, fp16 only).
#
# A full fine-tune of MolmoAct2 needs ~10.1 GiB of fp16 weights plus ~40 GiB of
# AdamW state, which cannot fit a 16 GB card. This run trains LoRA adapters over
# the frozen backbone instead, at micro-batch 1.
#
#   SETTINGS=training/settings.free_tier_colab.env training/train.sh
#
# Twenty optimizer steps is a pilot, not a training run: it exists to prove the
# dataloader, reverse pass, checkpoint and reload on the allocated GPU.
# ---------------------------------------------------------------------------
DATASET_ROOT=datasets/lerobot/chess_pilot
REPO_ID=local/chess_pilot
OUTPUT_DIR=outputs/free_tier_pilot

# 20 optimizer steps, with the block boundary at 20 so one block scores once
TOTAL_STEPS=20
BLOCK=20
BATCH_SIZE=1                 # micro-batch; the T4 cannot hold more of this model
GRAD_ACCUM=8                 # effective batch 8 at 1/8 the activation memory
NUM_WORKERS=0                # Colab's process limits; load in-process
SAVE_EVERY=10                # two checkpoints inside a short session

# adapters instead of a full fine-tune
PEFT=1
PEFT_R=16
MIXED_PRECISION=fp16         # T4 is Turing: it cannot compute bf16

# a small evaluation is still worth the time; it is one policy copy at a time
EVAL_EPISODES=4
EVAL_CAPTURES=0
EVAL_MAX_STEPS=450
