# Bounded adapter pilot for a free-tier Colab T4 (16 GB, fp16 only).
#
# MolmoAct2 already trains adapters: --policy.train_mode_vlm=lora is its default
# (lora_rank 64, ~737M trainable of 5.6B). This file does not add a second
# adapter mechanism; it shrinks the footprint and proves the pipeline.
#
# Frozen fp16 weights are ~10.1 GiB. Optimizer state for 737M trainable params
# is roughly 8-10 GiB more, so the default rank still exceeds a 16 GB card.
# Lowering the rank is the supported lever; the amount it frees is unmeasured.
#
#   SETTINGS=training/settings.free_tier_colab.env training/train.sh
#
# Twenty optimizer steps is a pilot, not a training run.
# ---------------------------------------------------------------------------
DATASET_ROOT=datasets/lerobot/chess_pilot
REPO_ID=local/chess_pilot
OUTPUT_DIR=outputs/free_tier_pilot

TOTAL_STEPS=20
BLOCK=20
BATCH_SIZE=1                 # micro-batch; the T4 cannot hold more of this model
GRAD_ACCUM=8                 # effective batch 8 at 1/8 the activation memory
NUM_WORKERS=0                # load in-process on a managed runtime
SAVE_EVERY=10                # two checkpoints inside a short session

# the recipe already emits --policy.train_mode_vlm=lora; only the rank differs
POLICY_FLAGS="--policy.lora_rank=8"
MIXED_PRECISION=fp16         # T4 is Turing: it cannot compute bf16

EVAL_EPISODES=4
EVAL_CAPTURES=0
EVAL_MAX_STEPS=450
