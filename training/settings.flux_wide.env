# FLUX 3 Action on the wide data. MolmoAct2 reached the named piece on half the wide
# episodes and never placed it (EXPERIMENTS 4.12-4.14); this changes the model: a 7B
# video-and-action transformer pretrained on the community SO-101 data, adapted with
# LoRA from its SO-101 package. It needs 30 Hz, so the data is a fresh stride-1 export
# of half of the per-episode-placement collection (every other worker shard of moves
# and of captures, the 2:1 mix kept), in the same SO-101 degree convention its
# statistics use. Everything below the model is as in settings.wide_base.env.
source training/settings.env
export PYTHON=~/vla/flux_venv/bin/python        # lerobot main: FLUX 3, NATTEN, torch cu130
export ACCELERATE=~/vla/flux_venv/bin/accelerate
POLICY=flux3
BASE_CHECKPOINT=black-forest-labs/flux-3-action-so101
CHUNK_SIZE=                     # the checkpoint's own: 42 predicted, 32 executed
DATASET_ROOT=datasets/lerobot/chess_flux_wide30
REPO_ID=XvKuoMing/so101_chess_flux_wide30       # a local label - nothing is pushed
OUTPUT_DIR=outputs/flux3_wide
BATCH_SIZE=1                    # batch 2 ran out of the 32 GB card at the first
GRAD_ACCUM=8                    # optimizer step; 1 x 8 keeps the preset's batch of 8
TOTAL_STEPS=80000               # micro-batches: 10,000 updates, 80,000 samples - four
                                # times the package's single-GPU budget. 0.83 s each, ~18.5 h
BLOCK=20000                     # the first check falls at the package's own budget
EVAL_SCENES=8
EVAL_HOME_EPISODES=16
HOLD_OUT_PIECE_SETS="marble token_disc_big"
HOLD_OUT_BOARD_FINISHES="cardboard"
