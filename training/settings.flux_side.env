# FLUX 3 Action on the side-camera data: the workspace camera on a tripod at the arm's
# left with no mast (chess_sim.config.SIDE_RIG_CAMERA), held there in every episode while
# board, pieces, lighting and table vary as in the wide collection. Collected with
# --fixed-camera side, exported at 30 Hz in the SO-101 degree convention. Model and
# schedule as in settings.flux_wide.env, from the published SO-101 package again.
source training/settings.flux_wide.env
DATASET_ROOT=datasets/lerobot/chess_flux_side30
REPO_ID=XvKuoMing/so101_chess_flux_side30       # a local label - nothing is pushed
OUTPUT_DIR=outputs/flux3_side
EVAL_FIXED_CAMERA=side          # both checks see the camera the data was recorded with
